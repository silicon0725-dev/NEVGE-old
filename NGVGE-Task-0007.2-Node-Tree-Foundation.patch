+                        {label: 'Polygon', value: 'polygon'}
+                    ],
+                    type: 'select'
+                },
+                {id: 'offsetX', label: 'Offset X', step: 1, type: 'number'},
+                {id: 'offsetY', label: 'Offset Y', step: 1, type: 'number'},
