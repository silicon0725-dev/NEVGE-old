+            <input
+                checked={Boolean(field.value)}
+                className={styles.checkbox}
+                disabled={field.disabled}
+                type="checkbox"
+                onChange={event => onCommit(event.target.checked)}
+            />
+        );
+    }
+
+    if (field.type === 'select') {
+        return (
+            <select
+                className={styles.select}
+                disabled={field.disabled}
