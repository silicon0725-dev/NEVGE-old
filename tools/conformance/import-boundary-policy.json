{
  "schema": "ngvge-arc-c001-import-boundary-policy/v1",
  "coreRoot": "src/core",
  "allowedBarePackages": [],
  "sourceExtensions": [
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx"
  ],
  "policy": {
    "localImportsMustRemainInsideCore": true,
    "bareImportsDefaultDeny": true,
    "nonLiteralDynamicImportsForbidden": true,
    "nonLiteralRequireForbidden": true,
    "symlinksForbiddenInsideCore": true
  },
  "forbiddenAmbientGlobals": [
    "Scratch",
    "ScratchBlocks",
    "React",
    "ReactDOM",
    "window",
    "document",
    "navigator",
    "HTMLElement",
    "Element",
    "NodeList",
    "HTMLCanvasElement",
    "MutationObserver",
    "ResizeObserver",
    "process",
    "Buffer",
    "global",
    "fetch",
    "WebSocket",
    "Worker",
    "SharedWorker",
    "OffscreenCanvas",
    "AudioContext",
    "webkitAudioContext",
    "localStorage",
    "sessionStorage",
    "indexedDB",
    "requestAnimationFrame",
    "cancelAnimationFrame",
    "setTimeout",
    "clearTimeout",
    "setInterval",
    "clearInterval",
    "crypto"
  ]
}
