+                            ))}
+                        </div>
+                    ) : null}
+                </div>
+                <div className={styles.cardFooter}>
+                    <button
+                        className={classNames(styles.cardActionButton, {
+                            [styles.cardActionButtonInstalled]: item.isInstalled
